# Copy to .env.local and fill in. Leave the Supabase values empty to run on the
# in-memory demo store (nothing is saved between restarts).

# Your site's address (server-only, so it can be a Sensitive variable on Vercel). On Vercel, set it to your domain (e.g. https://dibby.social),
# or leave it out and it uses the .vercel.app address.
SITE_URL=http://localhost:3000

# Supabase project (Sydney region): Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Signs the guest device cookie. `openssl rand -hex 32`
GUEST_COOKIE_SECRET=

# Day 2
ANTHROPIC_API_KEY=
# Places API (New), server-only: search, and checking a picked place is a real, open business.
# Leave empty in local dev to use a few made-up Sydney spots.
GOOGLE_PLACES_API_KEY=

# The map in the place picker (browser). A key with Maps JavaScript API on, restricted to your
# domains by HTTP referrer, and a Map ID (Google Cloud > Map management). Without the key the
# picker is a plain list.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Email (release notes to beta users). See packages/email/README.md.
# Resend API key, and a From address on a domain you've verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Dibby <hello@dibby.social>
# Replies go here, and it's the contact shown in every email's footer.
EMAIL_REPLY_TO=hello@dibby.social
# Who the email is from, shown in the footer (the Spam Act needs an accurate sender).
EMAIL_SENDER_NAME=Dibby, Sydney NSW

# /admin/usage: Dibby's AI cost. An Admin API key (sk-ant-admin…) from the Claude Console;
# only organisations can make one (Console > Settings > Organization). Server-only.
ANTHROPIC_ADMIN_KEY=
# Optional: only count this workspace, if Dibby's API key lives in its own one.
DIBBY_ANTHROPIC_WORKSPACE_ID=

# Universal links (plan links open the native app). Leave empty until the app is signed.
# Apple Developer > Membership details > Team ID.
APPLE_TEAM_ID=
# SHA-256 signing fingerprints, comma-separated: the EAS key (`npx eas-cli credentials -p android`)
# and, once on Play, the app signing key (Play Console > App integrity).
ANDROID_CERT_SHA256=

# A PO box or street address for the email footer (optional; needed if you email the US). Never a home address.
EMAIL_POSTAL_ADDRESS=
# Where reports go. Defaults to EMAIL_REPLY_TO. Needs RESEND_API_KEY and EMAIL_FROM on Vercel.
MODERATION_EMAIL=
# App Review sign-in (Apple 2.1): this email signs in with this 6-digit code, no email sent.
# A throwaway account only. Leave blank to switch it off.
APP_REVIEW_EMAIL=
APP_REVIEW_CODE=

# The app's beta (lib/beta.ts). Set either and /app shows the steps to get it (QR code on a
# computer) instead of the waitlist. Unset to close the beta; no deploy needed beyond the setting.
# TestFlight: App Store Connect → TestFlight → External Testing → your group → Create Public Link.
TESTFLIGHT_URL=
# Google Play internal or closed testing opt-in link, once there's an Android build.
PLAY_TESTING_URL=
